<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>2456b47a-7f2c-465a-983d-7ca73372921f</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>ОМСМ_лаба2.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>ОМСМ лаба2</Name>
    <RootNamespace>ОМСМ лаба2</RootNamespace>
    <InterpreterId>MSBuild|omsm_lab2_venv|$(MSBuildProjectFullPath)</InterpreterId>
    <Environment>PYTHONUTF8=1</Environment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="run_inference.py" />
    <Compile Include="ОМСМ_лаба2.py" />
    <Compile Include="yolo_common.py" />
    <Compile Include="lab2_main.py" />
    <Compile Include="check_gpu.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="requirements.txt" />
    <Content Include="README.md" />
    <Content Include="setup_env.bat" />
    <Content Include="run_smoke.bat" />
    <Content Include="run_lab.bat" />
    <Content Include="update_eval.bat" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="C:\Users\aasly\omsm_lab2\venv\">
      <Id>omsm_lab2_venv</Id>
      <Version>3.12</Version>
      <Description>omsm_lab2 venv (Python 3.12, PyTorch ROCm 10.1)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
